# Dependencies
node_modules/

# Python venv（pymupdf4llm 高保真引擎，setup 时生成）
.venv/

# Keep the two audited offline OCR languages in release source. Ignore any
# additional language caches downloaded by developers at runtime.
vendor/tessdata/*
!vendor/tessdata/eng.traineddata.gz
!vendor/tessdata/chi_sim.traineddata.gz
!vendor/tessdata/README.md

# Build outputs / temporary
dist/
build/
temp/

# Logs
*.log

# OS junk
.DS_Store
Thumbs.db
desktop.ini
